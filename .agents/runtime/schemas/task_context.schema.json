{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DurableTaskContext",
  "type": "object",
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "task_id": { "type": "string" },
    "project": { "type": "string" },
    "feature": { "type": "string" },
    "mode": { "type": "string", "enum": ["research", "plan", "code", "release"] },
    "status": { "type": "string" },
    "resume_cursor": { "type": "string" },
    "repository_snapshot": {
      "type": "object",
      "properties": {
        "hash": { "type": "string" },
        "files": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["hash", "files"]
    },
    "verification_commands": { "type": "object" },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "failure_budget": {
      "type": "object",
      "properties": {
        "limit": { "type": "integer", "minimum": 1 },
        "used": { "type": "integer", "minimum": 0 },
        "remaining": { "type": "integer", "minimum": 0 },
        "failed_attempts": { "type": "array" }
      },
      "required": ["limit", "used", "remaining", "failed_attempts"]
    }
  },
  "required": [
    "schema_version", "task_id", "project", "feature", "mode", "status",
    "resume_cursor", "repository_snapshot", "failure_budget"
  ]
}
