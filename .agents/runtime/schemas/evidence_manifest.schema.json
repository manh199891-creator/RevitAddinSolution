{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerificationEvidenceManifest",
  "type": "object",
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "run_id": { "type": "string" },
    "task_id": { "type": "string" },
    "created_at": { "type": "string" },
    "snapshot_before": { "type": "string" },
    "snapshot_after": { "type": "string" },
    "fresh": { "type": "boolean" },
    "status": { "type": "string", "enum": ["PASS", "FAIL"] },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": { "type": "string", "enum": ["build", "test", "lint"] },
          "command": { "type": ["string", "null"] },
          "required": { "type": "boolean" },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "N/A"] },
          "exit_code": { "type": ["integer", "null"] },
          "report": { "type": "string" },
          "output_sha256": { "type": "string" }
        },
        "required": ["stage", "required", "status", "report", "output_sha256"]
      }
    }
  },
  "required": [
    "schema_version", "run_id", "task_id", "snapshot_before",
    "snapshot_after", "fresh", "status", "results"
  ]
}
