<Project>
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2024</RevitVersion>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitInstallDir>
    <RevitAddinsDir Condition="'$(RevitAddinsDir)' == ''">$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)</RevitAddinsDir>
    <AntigravityDeployDir Condition="'$(AntigravityDeployDir)' == ''">$(RevitAddinsDir)\Antigravity</AntigravityDeployDir>
    <DeployToRevitAddins Condition="'$(DeployToRevitAddins)' == ''">false</DeployToRevitAddins>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Extensions" Version="2024.0.0" />
  </ItemGroup>
</Project>
