<Window x:Class="Antigravity.TagArranger.UI.ArrangerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Antigravity.Core.UI.Controls;assembly=Antigravity.Core"
        Title="Vilai Viet Tag Arranger"
        Width="340"
        Height="680"
        MinWidth="320"
        MinHeight="640"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Typography.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DataControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <!-- Compatibility aliases retained only for the P0 recovery pass.
             The strict-v3 layout pass replaces these with module-prefixed keys. -->
        <SolidColorBrush x:Key="GoldBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="LineBrush" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#F5F6F8"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#E5E7EB"/>
        <Style x:Key="HeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource VvSectionTitleStyle}"/>
        <Style x:Key="LabelStyle" TargetType="TextBlock" BasedOn="{StaticResource VvBodyTextStyle}"/>
        <Style x:Key="ComboStyle" TargetType="ComboBox" BasedOn="{StaticResource VvComboBoxStyle}"/>
        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource VvIconButtonStyle}"/>
        <Style x:Key="ActionBtn" TargetType="Button" BasedOn="{StaticResource VvPrimaryButtonStyle}"/>
        <Style x:Key="OrangeBtn" TargetType="Button" BasedOn="{StaticResource VvPrimaryButtonStyle}"/>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="Border" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ResourceDictionary>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Header -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>  <!-- 2: Align -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>  <!-- 4: Anti-Overlap -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>  <!-- 6: Distribute -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>  <!-- 8: Leader -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>  <!-- 10: Smart Stack -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>  <!-- 12: Merge -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>  <!-- 14: Options -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>  <!-- 16: AutoTag -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>     <!-- 18: Status -->
            <RowDefinition Height="Auto"/>  <!-- 19: Close -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <controls:BrandHeader Grid.Row="0" TitleText="Tag Arranger" SubtitleText="Align, arrange, and manage annotation leaders."/>

        <Rectangle Grid.Row="1" Fill="{StaticResource LineBrush}" Height="1"/>

        <!-- Align Section -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="ALIGN (Căn thẳng hàng)" Style="{StaticResource HeaderStyle}" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Offset (mm):" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtAlignOffset" Grid.Column="1" Text="0" Background="#F5F5F5"
                         Foreground="Black" BorderThickness="0" Padding="8,4" Height="28"
                         FontFamily="Segoe UI" FontSize="12"
                         ToolTip="Khoảng cách cách xa reference (ví dụ nhập 200 để Tag cách Dimension 200mm)"/>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource IconBtn}" Content="⬆" ToolTip="Align Top" Click="BtnAlignTop_Click"/>
                <Button Style="{StaticResource IconBtn}" Content="⬇" ToolTip="Align Bottom" Click="BtnAlignBottom_Click"/>
                <Button Style="{StaticResource IconBtn}" Content="⬅" ToolTip="Align Left" Click="BtnAlignLeft_Click"/>
                <Button Style="{StaticResource IconBtn}" Content="➡" ToolTip="Align Right" Click="BtnAlignRight_Click"/>
                <Button Style="{StaticResource IconBtn}" Content="⬌" ToolTip="Center Horizontal" Click="BtnAlignCenterH_Click"/>
                <Button Style="{StaticResource IconBtn}" Content="⬍" ToolTip="Center Vertical" Click="BtnAlignCenterV_Click"/>
            </StackPanel>
        </StackPanel>

        <Rectangle Grid.Row="3" Fill="{StaticResource LineBrush}" Height="1"/>

        <!-- Anti-Overlap Section -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="ANTI-OVERLAP (Chống đè chữ)" Style="{StaticResource HeaderStyle}" Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Spacing (mm):" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtSpacing" Grid.Column="1" Text="5" Background="#F5F5F5"
                         Foreground="Black" BorderThickness="0" Padding="8,4" Height="28"
                         FontFamily="Segoe UI" FontSize="12"/>
            </Grid>
            <Button Style="{StaticResource ActionBtn}" Content="UNTANGLE" Click="BtnUntangle_Click" Margin="0,8,0,0"/>
        </StackPanel>

        <Rectangle Grid.Row="5" Fill="{StaticResource LineBrush}" Height="1"/>

        <!-- Distribute Section -->
        <StackPanel Grid.Row="6">
            <TextBlock Text="DISTRIBUTE (Giãn đều)" Style="{StaticResource HeaderStyle}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Width="120" Height="32" Content="↔ Horizontal"
                        Background="{StaticResource SecondaryBrush}" Foreground="#000000"
                        BorderThickness="0" Cursor="Hand" Margin="4,0"
                        FontFamily="Segoe UI" FontSize="12" Click="BtnDistributeH_Click"/>
                <Button Width="120" Height="32" Content="↕ Vertical"
                        Background="{StaticResource SecondaryBrush}" Foreground="#000000"
                        BorderThickness="0" Cursor="Hand" Margin="4,0"
                        FontFamily="Segoe UI" FontSize="12" Click="BtnDistributeV_Click"/>
            </StackPanel>
        </StackPanel>

        <Rectangle Grid.Row="7" Fill="{StaticResource LineBrush}" Height="1"/>

        <!-- Leader Management Section -->
        <StackPanel Grid.Row="8">
            <TextBlock Style="{StaticResource HeaderStyle}" Margin="0,0,0,8">
                <Run Text="LEADER " Foreground="{StaticResource GoldBrush}"/><Run Text="(Quản lý đường dẫn)"/>
            </TextBlock>

            <!-- Leader Angle -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Leader Angle (°):" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtLeaderAngle" Grid.Column="1" Text="45" Background="#F5F5F5"
                         Foreground="Black" BorderThickness="0" Padding="6,4" Height="26"
                         FontFamily="Segoe UI" FontSize="12"/>
                <Button Grid.Column="2" Style="{StaticResource OrangeBtn}" Content="SET ANGLE" 
                        Click="BtnSetLeaderAngle_Click" Margin="8,0,0,0" Width="90"/>
            </Grid>

            <!-- Landing Distance -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Landing (mm):" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtLandingDistance" Grid.Column="1" Text="10" Background="#F5F5F5"
                         Foreground="Black" BorderThickness="0" Padding="6,4" Height="26"
                         FontFamily="Segoe UI" FontSize="12"/>
            </Grid>

            <!-- Leader Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource OrangeBtn}" Content="STRAIGHTEN" Width="85"
                        ToolTip="Làm thẳng landing line (nằm ngang)" Click="BtnStraightenLeaders_Click"/>
                <Button Style="{StaticResource OrangeBtn}" Content="PARALLELIZE" Width="85" Margin="4,0,4,0"
                        ToolTip="Làm tất cả leader song song (theo tag đầu tiên)" Click="BtnParallelizeLeaders_Click"/>
                <Button Style="{StaticResource OrangeBtn}" Content="ORTHOGONAL" Width="85"
                        ToolTip="Bẻ góc vuông tự động (ngang -> dọc)" Click="BtnOrthogonalLeaders_Click"/>
            </StackPanel>
        </StackPanel>

        <Rectangle Grid.Row="9" Fill="{StaticResource LineBrush}" Height="1"/>

        <!-- Smart Stack Section -->
        <StackPanel Grid.Row="10">
            <TextBlock Style="{StaticResource HeaderStyle}" Margin="0,0,0,8">
                <Run Text="SMART STACK " Foreground="{StaticResource GoldBrush}"/><Run Text="(Xếp chồng thông minh)"/>
            </TextBlock>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Horiz. Offset (mm):" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtHorizontalOffset" Grid.Column="1" Text="200" Background="#F5F5F5"
                         Foreground="Black" BorderThickness="0" Padding="8,4" Height="28"
                         FontFamily="Segoe UI" FontSize="12"
                         ToolTip="Khoảng cách từ Tag đến Elbow (mặc định 200mm)"/>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Button Style="{StaticResource OrangeBtn}" Content="STACK LEFT" Width="110" Height="30"
                        ToolTip="Xếp chồng các tag và kéo leader sang bên trái" Click="BtnStackLeft_Click"/>
                <Button Style="{StaticResource OrangeBtn}" Content="STACK RIGHT" Width="110" Height="30"
                        ToolTip="Xếp chồng các tag và kéo leader sang bên phải" Click="BtnStackRight_Click" Margin="12,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <Rectangle Grid.Row="11" Fill="{StaticResource LineBrush}" Height="1"/>

        <!-- Merge Tags Section -->
        <StackPanel Grid.Row="12">
            <TextBlock Style="{StaticResource HeaderStyle}" Margin="0,0,0,8">
                <Run Text="MERGE " Foreground="{StaticResource GoldBrush}"/><Run Text="(Gộp các Tag cùng loại)"/>
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton x:Name="RbMergeCenter" Content="Auto Center" IsChecked="True" Foreground="#000000" Margin="0,0,12,0"/>
                <RadioButton x:Name="RbMergePick" Content="Pick Point" Foreground="#000000" Margin="0,0,12,0"/>
                <RadioButton x:Name="RbSmartStack" Content="Smart Stack" Margin="0,0,0,0" Foreground="#000000"/>
            </StackPanel>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Scope:" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbMergeScope" Grid.Column="1" Height="26" SelectedIndex="0" Style="{StaticResource ComboStyle}">
                    <ComboBoxItem Content="Selected Elements (Đang quét chọn)"/>
                    <ComboBoxItem Content="Active View (Trong View này)"/>
                </ComboBox>
            </Grid>

            <Button Style="{StaticResource ActionBtn}" Content="MERGE TAGS" Background="#8A2BE2" Click="BtnMergeTags_Click" ToolTip="Gộp nhiều tag thành 1 tag có nhiều đường dẫn"/>
        </StackPanel>

        <Rectangle Grid.Row="13" Fill="{StaticResource LineBrush}" Height="1"/>

        <!-- Options -->
        <StackPanel Grid.Row="14">
            <TextBlock Text="OPTIONS" Style="{StaticResource HeaderStyle}" Margin="0,0,0,6"/>
            <CheckBox x:Name="ChkMaintainLeader" Content="Maintain Leader Position" IsChecked="True"/>
            <CheckBox x:Name="ChkIncludeTags" Content="Include Tags" IsChecked="True"/>
            <CheckBox x:Name="ChkIncludeDimensions" Content="Include Dimensions" IsChecked="True"/>
        </StackPanel>

        <Rectangle Grid.Row="15" Fill="{StaticResource LineBrush}" Height="1"/>

        <!-- Auto Tag -->
        <StackPanel Grid.Row="16">
            <TextBlock Style="{StaticResource HeaderStyle}" Margin="0,0,0,8">
                <Run Text="AUTO TAG " Foreground="{StaticResource GoldBrush}"/><Run Text="(Tự động ghi chú)"/>
            </TextBlock>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Leader Style:" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbAutoTagLeaderStyle" Grid.Column="1" Height="26" SelectedIndex="0" Style="{StaticResource ComboStyle}">
                    <ComboBoxItem Content="Orthogonal (Vuông góc)"/>
                    <ComboBoxItem Content="Angled (Góc nghiêng)"/>
                    <ComboBoxItem Content="Revit Default (Mặc định)"/>
                </ComboBox>
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Category:" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbAutoTagCategory" Grid.Column="1" Height="26" SelectedIndex="0" SelectionChanged="CmbAutoTagCategory_SelectionChanged" Style="{StaticResource ComboStyle}">
                    <ComboBoxItem Content="Walls"/>
                    <ComboBoxItem Content="Doors"/>
                    <ComboBoxItem Content="Windows"/>
                    <ComboBoxItem Content="Rooms"/>
                </ComboBox>
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Scope:" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbAutoTagScope" Grid.Column="1" Height="26" SelectedIndex="0" Style="{StaticResource ComboStyle}">
                    <ComboBoxItem Content="Active View (Trong View này)"/>
                    <ComboBoxItem Content="Selected Elements (Đang quét chọn)"/>
                    <ComboBoxItem Content="Entire Project (Toàn dự án)"/>
                </ComboBox>
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Tag Type:" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbTagType" Grid.Column="1" Height="26" SelectedIndex="0" DisplayMemberPath="Name" Style="{StaticResource ComboStyle}">
                </ComboBox>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Placement:" Style="{StaticResource LabelStyle}" Margin="0,0,8,0" Width="60"/>
                <RadioButton x:Name="RbAutoTagOffset" Content="Auto Offset" IsChecked="True" Foreground="#000000" Margin="0,0,12,0"/>
                <RadioButton x:Name="RbAutoTagPickPoint" Content="Pick Point" Foreground="#000000"/>
            </StackPanel>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Offset (mm):" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtAutoTagOffset" Grid.Column="1" Text="900" Background="#F5F5F5"
                         Foreground="Black" BorderThickness="0" Padding="8,4" Height="26"
                         FontFamily="Segoe UI" FontSize="12"
                         ToolTip="Khoảng cách chữ đẩy ra so với tường"/>

                <TextBlock Grid.Column="2" Text="Max Merge (m):" Style="{StaticResource LabelStyle}" Margin="12,0,8,0" ToolTip="Khoảng cách tối đa để gộp chung 1 Tag (nhập 0 để gộp vô hạn)"/>
                <TextBox x:Name="TxtMaxMergeDistance" Grid.Column="3" Text="10" Background="#F5F5F5"
                         Foreground="Black" BorderThickness="0" Padding="8,4" Height="26"
                         FontFamily="Segoe UI" FontSize="12"
                         ToolTip="Khoảng cách tối đa (mét) giữa các cấu kiện để gộp chung vào 1 Tag (ví dụ: 10m). Nếu để trống hoặc 0, gộp tất cả không giới hạn."/>
            </Grid>
            <CheckBox x:Name="ChkAutoUntangle" Content="Tự động né nhau (Anti-overlap) sau khi Tag" IsChecked="True" Margin="0,0,0,4"/>
            <CheckBox x:Name="ChkAutoTagLeader" Content="Tạo đường dẫn (Leader) cho Tag" IsChecked="False"/>
            <Button Style="{StaticResource ActionBtn}" Content="AUTO TAG" Background="#28A745" Click="BtnAutoTag_Click" Margin="0,8,0,0" ToolTip="Tự động tạo Tag cho các đối tượng chưa được tag trong View"/>
        </StackPanel>

        <Rectangle Grid.Row="17" Fill="{StaticResource LineBrush}" Height="1"/>

        <!-- Status -->
        <Border Grid.Row="18" Background="{StaticResource PanelBrush}" Padding="10" CornerRadius="3" MinHeight="40">
            <TextBlock x:Name="TxtStatus"
                       Text="Ready. Chọn các Tag/Dimension rồi bấm nút tương ứng."
                       Style="{StaticResource LabelStyle}"
                       TextWrapping="Wrap"
                       FontSize="11"/>
        </Border>

        <!-- Close -->
        <Grid Grid.Row="19" Margin="0,8,0,0">
            <Button Content="CLOSE" Height="30"
                    Background="{StaticResource SecondaryBrush}" Foreground="#000000"
                    BorderThickness="0" FontFamily="Segoe UI" FontSize="12"
                    FontWeight="Bold" Cursor="Hand"
                    Click="BtnClose_Click"/>
            <controls:BrandSignature Margin="0,8,0,0"/>
        </Grid>
    </Grid>
    </ScrollViewer>
</Window>



