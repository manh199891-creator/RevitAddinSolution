<Window x:Class="Antigravity.Core.UI.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xác thực" Height="280" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FFFFFF" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Typography.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DataControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background"       Value="#35393E"/>
            <Setter Property="Foreground"       Value="#111827"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
        </Style>
    </ResourceDictionary>
    </Window.Resources>
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1" Margin="-16,-16,-16,20" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Canvas Width="100" Height="80">
                        <Path Fill="#1B3679" Data="M 30,10 L 70,10 L 50,45 Z"/>
                        <Path Fill="#D8262C" Data="M 10,10 L 32,10 L 50,55 L 68,10 L 90,10 L 50,80 Z"/>
                    </Canvas>
                </Viewbox>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#111827">
                        <Run Text="VILA" Foreground="#1B3679"/><Run Text="I"><Run.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#1B3679" Offset="0.7"/><GradientStop Color="#D8262C" Offset="0.7"/></LinearGradientBrush></Run.Foreground></Run><Run Text="VIET" Foreground="#D8262C"/><Run Text=" · XÁC THỰC BẢN QUYỀN" Foreground="#111827" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock Text="Máy tính này không nằm trong danh sách được phép" 
                               FontSize="11" Foreground="#6B7280" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,10">
            <TextBlock Text="Mật khẩu Master:" Margin="0,0,0,5" FontSize="12" Foreground="#4B5563"/>
            <PasswordBox x:Name="txtPassword" Height="32" FontSize="14"
                         Background="#FFFFFF" Foreground="#111827" BorderBrush="#D1D5DB"
                         BorderThickness="1" Padding="8,4"
                         KeyDown="TxtPassword_KeyDown"/>
            
            <TextBlock x:Name="lblError" Text="" Foreground="#B91C1C" 
                       FontSize="11" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnCancel" Content="HỦY" Width="90" Height="36"
                        Background="#E5E7EB" Foreground="#111827" FontWeight="Bold"
                        Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button x:Name="btnUnlock" Content="MỞ KHÓA" Width="110" Height="36"
                        Background="#007ACC" Foreground="White" FontWeight="Bold"
                        Click="BtnUnlock_Click"/>
            </StackPanel>
            <TextBlock Text="@manhns" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280" Opacity="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False" Focusable="False"/>
        </Grid>
    </Grid>
</Window>
