<Window x:Class="Antigravity.Autojoin.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Antigravity.Core.UI.Controls;assembly=Antigravity.Core"
        xmlns:local="clr-namespace:Antigravity.Autojoin.UI"
        xmlns:models="clr-namespace:Antigravity.Autojoin.Models"
        Title="Vilai Viet AutoJoin"
        Width="950" Height="550"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        Foreground="#000000"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True" MinWidth="720" MinHeight="420">

        <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Typography.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DataControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="Border" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="20"/> <!-- Gap -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── LEFT: CONFIGURATION ── -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Header -->
                <RowDefinition Height="10"/>   <!-- 1: Space -->
                <RowDefinition Height="Auto"/> <!-- 2: Scope -->
                <RowDefinition Height="10"/>   <!-- 3: Space -->
                <RowDefinition Height="*"/>    <!-- 4: Rules -->
                <RowDefinition Height="10"/>   <!-- 5: Space -->
                <RowDefinition Height="Auto"/> <!-- 6: DMU -->
                <RowDefinition Height="10"/>   <!-- 7: Space -->
                <RowDefinition Height="Auto"/> <!-- 8: Actions -->
                <RowDefinition Height="10"/>   <!-- 9: Space -->
                <RowDefinition Height="Auto"/> <!-- 10: Status -->
            </Grid.RowDefinitions>

            <!-- 0: Brand Header -->
            <controls:BrandHeader Grid.Row="0" TitleText="AutoJoin" SubtitleText="Automatic structural elements join coordination"/>

            <Separator Grid.Row="1" Background="{DynamicResource VvBorderBrush}" Margin="0,10,0,0"/>

            <!-- 2: Scope -->
            <StackPanel Grid.Row="2" Margin="0,5,0,0">
                <TextBlock Text="SCOPE" Style="{StaticResource VvBodyTextStyle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource VvTextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="5,5,0,0">
                    <RadioButton x:Name="RbActiveView" Content="Active View" IsChecked="True"/>
                    <RadioButton x:Name="RbSelection"  Content="Selection"/>
                </StackPanel>
            </StackPanel>

            <Separator Grid.Row="3" Background="{DynamicResource VvBorderBrush}" Margin="0,10"/>

            <!-- 4: Rules -->
            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,5">
                    <TextBlock Text="PAIR-BASED JOIN RULES" Style="{StaticResource VvBodyTextStyle}" FontWeight="Bold" Foreground="{DynamicResource VvTextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnAddRule"    Content="＋" Width="24" Height="24" Style="{StaticResource SecondaryBtn}" Margin="0,0,4,0" Click="BtnAddRule_Click" Padding="0"/>
                        <Button x:Name="BtnRemoveRule" Content="🗑" Width="24" Height="24" Style="{StaticResource SecondaryBtn}" Click="BtnRemoveRule_Click" Padding="0"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource VvSurfaceBrush}" BorderBrush="{DynamicResource VvBorderBrush}" BorderThickness="1" CornerRadius="4">
                    <ListView x:Name="RulesListView" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource VvTextPrimaryBrush}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{x:Static models:JoinRule.SupportedCategories}"
                                              SelectedItem="{Binding CategoryA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource VvComboBoxStyle}"
                                              SelectionChanged="CategoryComboBox_SelectionChanged"/>
                                    <TextBlock Grid.Column="1" Text="→" Foreground="{DynamicResource VvAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{x:Static models:JoinRule.SupportedCategories}"
                                              SelectedItem="{Binding CategoryB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource VvComboBoxStyle}"
                                              SelectionChanged="CategoryComboBox_SelectionChanged"/>
                                    <CheckBox Grid.Column="3" Content="Enabled" IsChecked="{Binding IsEnabled}" Margin="10,0,0,0" ToolTip="Enable or disable this join pair"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Foreground" Value="{DynamicResource VvTextPrimaryBrush}"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button x:Name="BtnReload" Content="↺  Reload" Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0" Click="BtnReload_Click" Padding="10,5"/>
                    <Button x:Name="BtnSave"   Content="💾  Save Configuration" Style="{StaticResource SecondaryBtn}" Click="BtnSave_Click" Padding="10,5"/>
                </StackPanel>
            </Grid>

            <Separator Grid.Row="5" Background="{DynamicResource VvBorderBrush}" Margin="0,10"/>

            <!-- 6: DMU -->
            <Grid Grid.Row="6">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="⚡ AUTO JOIN REALTIME" FontWeight="Bold" Foreground="{DynamicResource VvTextPrimaryBrush}" FontSize="12"/>
                    <TextBlock Text="Join automatically when elements are created or modified" FontSize="11" Foreground="{DynamicResource VvTextSecondaryBrush}"/>
                </StackPanel>
                <CheckBox x:Name="ChkDmuEnabled" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="ChkDmu_Changed" Unchecked="ChkDmu_Changed"/>
            </Grid>

            <Separator Grid.Row="7" Background="{DynamicResource VvBorderBrush}" Margin="0,10"/>

            <!-- 8: Actions -->
            <UniformGrid Grid.Row="8" Rows="1" Columns="2">
                <Button x:Name="BtnJoin"   Content="⛓  JOIN GEOMETRY" Style="{StaticResource PrimaryBtn}" Margin="0,0,5,0" Click="BtnJoin_Click"/>
                <Button x:Name="BtnUnjoin" Content="✂  UNJOIN"        Style="{StaticResource SecondaryBtn}" Margin="5,0,0,0" Click="BtnUnjoin_Click"/>
            </UniformGrid>

            <!-- 10: Status -->
            <StackPanel Grid.Row="10" Margin="0,0,0,0">
                <ProgressBar x:Name="PrgBar" IsIndeterminate="True" Height="2" Margin="0,0,0,4" Visibility="Collapsed" Foreground="{DynamicResource VvAccentBrush}" Background="Transparent"/>
                <TextBlock x:Name="TxtStatus" Text="Ready." Foreground="{DynamicResource VvTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- ── RIGHT: RESULTS ── -->
        <Border Grid.Column="2" Background="{DynamicResource VvSurfaceSubtleBrush}" BorderBrush="{DynamicResource VvBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Stats -->
                    <RowDefinition Height="Auto"/> <!-- Space -->
                    <RowDefinition Height="Auto"/> <!-- Failed Title -->
                    <RowDefinition Height="*"/>    <!-- Failed List -->
                    <RowDefinition Height="Auto"/> <!-- Watermark -->
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="EXECUTION RESULTS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource VvAccentBrush}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Intersections found:" Foreground="{DynamicResource VvTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Joined successfully:" Foreground="{DynamicResource VvTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Previously joined:" Foreground="{DynamicResource VvTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Failed or unable to join:" Foreground="#D8262C" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock x:Name="TxtTotalInt" Text="0" TextAlignment="Right" Foreground="{DynamicResource VvTextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtJoined"   Text="0" TextAlignment="Right" Foreground="{DynamicResource VvTextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtAlready"  Text="0" TextAlignment="Right" Foreground="{DynamicResource VvTextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtFailed"   Text="0" TextAlignment="Right" Foreground="#D8262C" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Separator Grid.Row="1" Background="{DynamicResource VvBorderBrush}" Margin="0,12"/>

                <TextBlock Grid.Row="2" Text="UNRESOLVED INTERSECTIONS" FontSize="11" FontWeight="Bold" Foreground="#D8262C" Margin="0,0,0,8"/>

                <ListView x:Name="FailedListView" Grid.Row="3" Background="{DynamicResource VvSurfaceBrush}" BorderBrush="{DynamicResource VvBorderBrush}" BorderThickness="1" Foreground="{DynamicResource VvTextPrimaryBrush}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Element A" Width="120" DisplayMemberBinding="{Binding ElementA}"/>
                            <GridViewColumn Header="Element B" Width="120" DisplayMemberBinding="{Binding ElementB}"/>
                            <GridViewColumn Header="Lý do"     Width="150" DisplayMemberBinding="{Binding Reason}"/>
                        </GridView>
                    </ListView.View>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="{DynamicResource VvTextPrimaryBrush}"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource VvBorderBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>


            </Grid>
        </Border>
    </Grid>
</Window>


