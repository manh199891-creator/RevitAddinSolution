<Window x:Class="Antigravity.IssueManager.UI.IssueManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Antigravity.Core.UI.Controls;assembly=Antigravity.Core"
        xmlns:localModels="clr-namespace:Antigravity.IssueManager.Models"
        Title="Vilai Viet Issue Manager" Height="680" Width="1050"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#FFFFFF"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True" MinWidth="800" MinHeight="520">
        <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Typography.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DataControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DestructiveBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#D8262C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="Border" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="16"/>   <!-- Separator -->
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="16"/>   <!-- Separator -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Status padding -->
        </Grid.RowDefinitions>

        <!-- Brand Header -->
        <controls:BrandHeader Grid.Row="0" TitleText="Issue Manager" SubtitleText="Manage, create and review BCF issues"/>

        <!-- Toolbar -->
        <WrapPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Button Content="Load BCF" Click="BtnLoadBcf_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"/>
            <Button Content="Load XML" Click="BtnLoadXml_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"/>
            <Button Content="Reload Backup" Click="BtnReloadBackup_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"/>
            <Button x:Name="BtnCreateIssue" Content="Create Issue" Click="BtnCreateIssue_Click" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0"/>
            <Button x:Name="BtnExportBcf" Content="Export BCF" Click="BtnExportBcf_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"/>
            <Button x:Name="BtnExportExcel" Content="Export Excel" Click="BtnExportExcel_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"/>
            <Button x:Name="BtnNewFolder" Content="New Folder" Click="BtnNewFolder_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"/>
            <CheckBox x:Name="ChkIncludeSectionBox" Content="Section Box" IsChecked="True" Foreground="#000000" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <CheckBox x:Name="ChkUseSharedCoordinates" Content="Shared Coords" IsChecked="True" Foreground="#000000" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <ComboBox x:Name="CmbViewMode" Width="120" Margin="8,0,0,0" SelectionChanged="CmbViewMode_SelectionChanged" SelectedIndex="0">
                <ComboBoxItem Content="Flat List"/>
                <ComboBoxItem Content="Group By Element"/>
                <ComboBoxItem Content="Group By Folder"/>
            </ComboBox>
        </WrapPanel>

        <!-- Content -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Issue List -->
            <Border Grid.Column="0" Background="#F5F6F8" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4">
                <Grid>
                <ListView x:Name="LvIssues" SelectionChanged="LvIssues_SelectionChanged" Background="Transparent" BorderThickness="0" Margin="5">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5">
                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="12" Foreground="#000000" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ClashFileSummary}" Foreground="#4B5563" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding Status}" Foreground="#4B5563" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Foreground" Value="#F5F6F8"/>
                            <Setter Property="Margin" Value="0,0,0,2"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
                <TreeView x:Name="TvIssueGroups" Visibility="Collapsed" SelectedItemChanged="TvIssueGroups_SelectedItemChanged" Background="Transparent" BorderThickness="0" Margin="5">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type localModels:IssueGroupModel}" ItemsSource="{Binding Issues}">
                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" Foreground="#000000">
                                <TextBlock.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Resolve All" Click="ResolveGroup_Click"/>
                                    </ContextMenu>
                                </TextBlock.ContextMenu>
                            </TextBlock>
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type localModels:IssueModel}">
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding DisplayTitle}" Foreground="#000000" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ClashFileSummary}" Foreground="#4B5563" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding Status}" Foreground="#4B5563" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
                </Grid>
            </Border>

            <!-- Right Column: Issue Details -->
            <Border Grid.Column="2" Background="#F5F6F8" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header info -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock x:Name="TxtTitle" Text="Select an issue..." FontSize="16" FontWeight="SemiBold" Foreground="#000000" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtDesc" Text="" FontSize="12" Foreground="#4B5563" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtAuthor" Text="" Foreground="#4B5563" FontSize="11" Margin="0,5,0,0"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Status" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1" x:Name="CmbIssueStatus" Width="130" SelectionChanged="CmbIssueStatus_SelectionChanged" IsEnabled="False">
                                <ComboBoxItem Content="New"/>
                                <ComboBoxItem Content="Active"/>
                                <ComboBoxItem Content="Resolved"/>
                                <ComboBoxItem Content="Approved"/>
                            </ComboBox>

                            <TextBlock Grid.Column="3" Text="Folder" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="4" x:Name="CmbIssueFolder" Width="130" IsEditable="True" IsEnabled="False" LostFocus="CmbIssueFolder_LostFocus" SelectionChanged="CmbIssueFolder_SelectionChanged" />
                            <Button Grid.Column="5" x:Name="BtnCreateFolderForIssue" Content="New" Click="BtnCreateFolderForIssue_Click" Style="{StaticResource SecondaryBtn}" IsEnabled="False" Margin="8,0,0,0"/>

                            <TextBlock Grid.Column="7" x:Name="TxtClashFiles" Text="" Foreground="#4B5563" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- Image Snapshot -->
                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,5,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Image Grid.Row="0" x:Name="ImgSnapshot" Stretch="Uniform"/>
                                <Button Grid.Row="1" x:Name="BtnMarkupSnapshot3D" Content="✏️ Markup 3D" Click="BtnMarkupSnapshot3D_Click" Style="{StaticResource SecondaryBtn}" Margin="4" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" Margin="5,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Image Grid.Row="0" x:Name="ImgSnapshot2" Stretch="Uniform"/>
                                <Button Grid.Row="1" x:Name="BtnMarkupSnapshot2D" Content="✏️ Markup 2D" Click="BtnMarkupSnapshot2D_Click" Style="{StaticResource SecondaryBtn}" Margin="4" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Actions -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnEditIssue" Content="Edit" Click="BtnEditIssue_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,10,0" IsEnabled="False"/>
                        <Button Content="Show in Model" Click="BtnShowInModel_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,10,0"/>
                        <Button x:Name="BtnIsolateClash" Content="Isolate Clash Elements" Click="BtnIsolateClash_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,10,0"/>
                        <Button x:Name="BtnVerifyClash" Content="Verify" Click="BtnVerifyClash_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,10,0"/>
                        <Button x:Name="BtnModelClashPoint" Content="Model Clash Point" Click="BtnModelClashPoint_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,10,0"/>
                        <Button x:Name="BtnDeleteIssue" Content="Delete" Click="BtnDeleteIssue_Click" Style="{StaticResource DestructiveBtn}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar / Dashboard -->
        <Border Grid.Row="5" Background="#F5F6F8" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="10,5" Margin="0,16,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtTotal" Text="Total: 0" Foreground="#000000" FontWeight="SemiBold" Margin="0,0,15,0"/>
                    <TextBlock x:Name="TxtNew" Text="New: 0" Foreground="#007ACC" FontWeight="SemiBold" Margin="0,0,15,0"/>
                    <TextBlock x:Name="TxtActive" Text="Active: 0" Foreground="#FFD700" FontWeight="SemiBold" Margin="0,0,15,0"/>
                    <TextBlock x:Name="TxtResolved" Text="Resolved: 0" Foreground="#55FF55" FontWeight="SemiBold" Margin="0,0,15,0"/>
                    <TextBlock x:Name="TxtApproved" Text="Approved: 0" Foreground="#55FFFF" FontWeight="SemiBold"/>
                </StackPanel>


            </Grid>
        </Border>
    </Grid>
</Window>



