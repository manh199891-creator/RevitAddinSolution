<Window x:Class="Antigravity.IssueManager.UI.MarkupEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Antigravity.Core.UI.Controls;assembly=Antigravity.Core"
        xmlns:local="clr-namespace:Antigravity.IssueManager.UI"
        Title="Vilai Viet Markup Editor" Width="900" Height="650"
        Background="#FFFFFF" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True" ResizeMode="CanResize" MinWidth="720" MinHeight="520">
      <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Typography.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DataControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
      <Style TargetType="ToggleButton">
          <Setter Property="Height" Value="32"/>
          <Setter Property="Background" Value="#E5E7EB"/>
          <Setter Property="Foreground" Value="#000000"/>
          <Setter Property="BorderThickness" Value="1"/>
          <Setter Property="BorderBrush" Value="#D1D5DB"/>
          <Setter Property="Padding" Value="10,0"/>
          <Setter Property="Margin" Value="0,0,6,0"/>
          <Setter Property="Cursor" Value="Hand"/>
          <Setter Property="FontFamily" Value="Segoe UI"/>
          <Setter Property="FontSize" Value="12"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Style.Triggers>
              <Trigger Property="IsChecked" Value="True">
                  <Setter Property="Background" Value="#007ACC"/>
                  <Setter Property="Foreground" Value="#FFFFFF"/>
                  <Setter Property="BorderBrush" Value="#007ACC"/>
              </Trigger>
          </Style.Triggers>
      </Style>
      <Style x:Key="PrimaryBtn" TargetType="Button">
          <Setter Property="Height" Value="32"/>
          <Setter Property="Background" Value="#007ACC"/>
          <Setter Property="Foreground" Value="White"/>
          <Setter Property="FontFamily" Value="Segoe UI"/>
          <Setter Property="FontSize" Value="12"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="Cursor" Value="Hand"/>
          <Setter Property="Template">
              <Setter.Value>
                  <ControlTemplate TargetType="Button">
                      <Border CornerRadius="4" Background="{TemplateBinding Background}" Padding="12,0">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                  </ControlTemplate>
              </Setter.Value>
          </Setter>
      </Style>
      <Style x:Key="SecondaryBtn" TargetType="Button">
          <Setter Property="Height" Value="32"/>
          <Setter Property="Background" Value="#E5E7EB"/>
          <Setter Property="Foreground" Value="#000000"/>
          <Setter Property="FontFamily" Value="Segoe UI"/>
          <Setter Property="FontSize" Value="12"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="Cursor" Value="Hand"/>
          <Setter Property="Template">
              <Setter.Value>
                  <ControlTemplate TargetType="Button">
                      <Border CornerRadius="4" Background="{TemplateBinding Background}" Padding="12,0">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                  </ControlTemplate>
              </Setter.Value>
          </Setter>
      </Style>
  </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- Header -->
      <RowDefinition Height="12"/>
      <RowDefinition Height="Auto"/>   <!-- Toolbar -->
      <RowDefinition Height="12"/>
      <RowDefinition Height="*"/>      <!-- Canvas area -->
      <RowDefinition Height="12"/>
      <RowDefinition Height="Auto"/>   <!-- Bottom buttons -->
    </Grid.RowDefinitions>

    <controls:BrandHeader Grid.Row="0" TitleText="MARKUP EDITOR" SubtitleText="Annotate the captured issue view."/>

    <!-- TOOLBAR -->
    <Border Grid.Row="2" Background="#F5F6F8" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="6">
      <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ToggleButton x:Name="BtnPen"       Content="🖊️ Pen"       IsChecked="True" Checked="BtnPen_Checked"/>
        <ToggleButton x:Name="BtnRect"      Content="⬜ Rect"      Checked="BtnRect_Checked"/>
        <ToggleButton x:Name="BtnArrow"     Content="➡️ Arrow"     Checked="BtnArrow_Checked"/>
        <ToggleButton x:Name="BtnText"      Content="🔤 Text"      Checked="BtnText_Checked"/>
        
        <Border BorderBrush="#D1D5DB" BorderThickness="1,0,0,0" Margin="4,2,10,2"/>

        <ComboBox x:Name="CmbColor" Width="110" SelectionChanged="CmbColor_Changed" VerticalAlignment="Center" Margin="0,0,10,0" Height="28">
          <ComboBoxItem Tag="#FF0000" Content="🔴 Đỏ"     IsSelected="True"/>
          <ComboBoxItem Tag="#FFD700" Content="🟡 Vàng"/>
          <ComboBoxItem Tag="#00CC00" Content="🟢 Xanh lá"/>
          <ComboBoxItem Tag="#00AAFF" Content="🔵 Xanh dương"/>
          <ComboBoxItem Tag="#FFFFFF" Content="⬜ Trắng"/>
        </ComboBox>
        
        <Border BorderBrush="#D1D5DB" BorderThickness="1,0,0,0" Margin="4,2,10,2"/>

        <Button Content="↩️ Undo"  Click="BtnUndo_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"/>
        <Button Content="🗑️ Clear" Click="BtnClear_Click" Style="{StaticResource SecondaryBtn}"/>
      </WrapPanel>
    </Border>

    <!-- CANVAS AREA -->
    <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4">
      <Grid x:Name="MarkupPanel" Background="Transparent" ClipToBounds="True">
        <Image x:Name="ImgBase" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <InkCanvas x:Name="InkLayer"
                   Background="Transparent"
                   EditingMode="Ink"
                   MouseDown="InkLayer_MouseDown"
                   MouseMove="InkLayer_MouseMove"
                   MouseUp="InkLayer_MouseUp"/>
      </Grid>
    </Border>

    <!-- BOTTOM BUTTONS -->
    <Grid Grid.Row="6">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="✖ Huỷ"         Click="BtnCancel_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"/>
        <Button Content="💾 Lưu markup" Click="BtnSave_Click" Style="{StaticResource PrimaryBtn}"/>
      </StackPanel>
      <controls:BrandSignature Margin="0,8,0,0"/>
    </Grid>
  </Grid>
</Window>


