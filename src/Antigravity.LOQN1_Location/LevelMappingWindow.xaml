<Window x:Class="LOQN1_Location_element.LevelMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Antigravity.Core.UI.Controls;assembly=Antigravity.Core"
        mc:Ignorable="d"
        Title="Level Mapping &amp; Element Selection" Height="550" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource VvSurfaceBrush}">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DesignTokens.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Typography.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DataControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <controls:BrandHeader TitleText="Level Mapping &amp; Element Selection" Grid.Row="0" Margin="0,0,0,15"/>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Filters -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource VvTextPrimaryBrush}"/>
                    <ComboBox x:Name="CmbCategory" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="CmbCategory_SelectionChanged" Style="{StaticResource VvComboBoxStyle}"/>

                    <TextBlock Grid.Column="2" Text="Family Type:" VerticalAlignment="Center" Margin="20,0,10,0" Foreground="{DynamicResource VvTextPrimaryBrush}"/>
                    <ComboBox x:Name="CmbFamilyType" Grid.Column="3" DisplayMemberPath="Name" Style="{StaticResource VvComboBoxStyle}"/>
                </Grid>
                
                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <TextBlock Text="Apply to:" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="{DynamicResource VvTextPrimaryBrush}"/>
                    <RadioButton x:Name="RbAllInstances" Content="All instances" Margin="0,0,15,0" Foreground="{DynamicResource VvTextPrimaryBrush}"/>
                    <RadioButton x:Name="RbSelected" Content="Selected elements only" Foreground="{DynamicResource VvTextPrimaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- DataGrid -->
            <DataGrid x:Name="DgvMapping" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" 
                      Style="{StaticResource VvDataGridStyle}" Background="{DynamicResource VvSurfaceBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="No." Binding="{Binding Number}" Width="40" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Revit Level" Binding="{Binding OriginalName}" Width="200" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Elevation (m)" Binding="{Binding ElevationString}" Width="100" IsReadOnly="True"/>
                    
                    <DataGridTemplateColumn Header="→ Display Name" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" 
                                         Padding="2" VerticalContentAlignment="Center" Background="{DynamicResource VvSurfaceBrush}" Foreground="{DynamicResource VvTextPrimaryBrush}" BorderBrush="{DynamicResource VvBorderBrush}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Auto Fill" Click="BtnAutoFill_Click" Style="{StaticResource VvSecondaryButtonStyle}" Margin="0,0,10,0" Width="100"/>
                <Button Content="Clear" Click="BtnClear_Click" Style="{StaticResource VvSecondaryButtonStyle}" Margin="0,0,10,0" Width="100"/>
                <Button Content="Save Mapping" Click="BtnSave_Click" Style="{StaticResource VvSecondaryButtonStyle}" Width="120"/>
                <TextBlock x:Name="LblStatus" Foreground="{DynamicResource VvAccentBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="BtnCancel_Click" Style="{StaticResource VvSecondaryButtonStyle}" Margin="0,0,10,0" Width="80"/>
                <Button Content="OK" Click="BtnOK_Click" Style="{StaticResource VvPrimaryButtonStyle}" Width="80"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
