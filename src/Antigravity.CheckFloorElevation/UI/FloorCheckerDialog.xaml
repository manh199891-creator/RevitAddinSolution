<Window x:Class="Antigravity.CheckFloorElevation.UI.FloorCheckerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Antigravity.Core.UI.Controls;assembly=Antigravity.Core"
        Title="Vilai Viet - Check Floor Elevation" Height="640" Width="980" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#FFFFFF" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">

        <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Typography.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DataControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <!-- Style chung cho Label -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- Style chung cho ComboBox -->
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#282B30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2F333A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Focusable="false" ClickMode="Press" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Name="Border" CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Name="Arrow" Grid.Column="1" Fill="#000000" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#2F333A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,0,24,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Name="DropDownBorder" Background="#FFFFFF" BorderThickness="1" BorderBrush="#D1D5DB" CornerRadius="0,0,4,4"/>
                                    <ScrollViewer Margin="0,4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style chung cho TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="Border" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style nút chính -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="Background" Value="#101047"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="RowBackground" Value="#101047"/>
            <Setter Property="AlternatingRowBackground" Value="#1F1F6E"/>
            <Setter Property="BorderBrush" Value="#4B4BC4"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#38389A"/>
            <Setter Property="VerticalGridLinesBrush" Value="#38389A"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#E8ECFF"/>
                        <Setter Property="Foreground" Value="#0F172A"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="BorderBrush" Value="#A7B3FF"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="6,4"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="Padding" Value="6,2"/>
                        <Setter Property="BorderBrush" Value="#38389A"/>
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FFD700"/>
                                <Setter Property="Foreground" Value="#111111"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="10"/>   <!-- Sep -->
            <RowDefinition Height="Auto"/> <!-- Inputs -->
            <RowDefinition Height="10"/>   <!-- Sep -->
            <RowDefinition Height="Auto"/> <!-- Progress -->
            <RowDefinition Height="10"/>   <!-- Sep -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
            <RowDefinition Height="10"/>   <!-- Sep -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- ── TIÊU ĐỀ ── -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1" Margin="-16,-16,-16,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Canvas Width="100" Height="80">
                        <Path Fill="#1B3679" Data="M 30,10 L 70,10 L 50,45 Z"/>
                        <Path Fill="#D8262C" Data="M 10,10 L 32,10 L 50,55 L 68,10 L 90,10 L 50,80 Z"/>
                    </Canvas>
                </Viewbox>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="#111827">
                                <Run Text="VILA" Foreground="#1B3679"/><Run Text="I"><Run.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#1B3679" Offset="0.7"/><GradientStop Color="#D8262C" Offset="0.7"/></LinearGradientBrush></Run.Foreground></Run><Run Text="VIET" Foreground="#D8262C"/><Run Text=" · AUTO FLOOR CHECKER" Foreground="#111827" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock Text="Check elevation differences between host and linked floors" 
                                       FontSize="11" Foreground="#6B7280" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtSummary" Grid.Column="1" HorizontalAlignment="Right" Foreground="#000000" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Rectangle Grid.Row="1" Height="1" Fill="#D1D5DB" Margin="0,4"/>

        <!-- ── INPUTS ── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="🔗  Linked structural model" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="CmbLinks" Style="{StaticResource ComboStyle}" DisplayMemberPath="Name"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Host level" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="CmbHostLevels" Style="{StaticResource ComboStyle}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Click="LevelCheckBox_Click"
                                      Foreground="#4B5563"
                                      FontFamily="Segoe UI"
                                      FontSize="12"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="4">
                <TextBlock Text="📏  Tolerance (mm)" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="TxtTolerance" Style="{StaticResource ModernTextBox}" Text="20"/>
            </StackPanel>

            <StackPanel Grid.Column="6" VerticalAlignment="Bottom" Margin="0,0,0,4">
                <CheckBox x:Name="ChkActiveViewOnly" Content="Active view only" Foreground="#4B5563" FontFamily="Segoe UI" FontSize="12"/>
            </StackPanel>
        </Grid>

        <Rectangle Grid.Row="3" Height="1" Fill="#D1D5DB" Margin="0,4"/>

        <!-- ── PROGRESS ── -->
        <Grid x:Name="PanelProgress" Grid.Row="4" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="TxtProgress" Foreground="#4B5563" FontFamily="Segoe UI" FontSize="12" Margin="0,0,0,6"/>
                <ProgressBar x:Name="PbProgress" Height="8" Minimum="0"/>
            </StackPanel>
        </Grid>

        <Rectangle Grid.Row="5" Height="1" Fill="#D1D5DB" Margin="0,4" x:Name="SepProgress" Visibility="Collapsed"/>

        <!-- ── DATAGRID ── -->
        <DataGrid x:Name="GridResults" Grid.Row="6" Style="{StaticResource DataGridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Host Floor ID" Binding="{Binding HostFloorId}" Width="110"/>
                <DataGridTextColumn Header="Link Floor ID" Binding="{Binding LinkFloorIdDisplay}" Width="110"/>
                <DataGridTextColumn Header="Host Type" Binding="{Binding HostTypeName}" Width="180"/>
                <DataGridTextColumn Header="Link Type" Binding="{Binding LinkTypeNameDisplay}" Width="180"/>
                <DataGridTextColumn Header="Level" Binding="{Binding LevelName}" Width="*"/>
                <DataGridTextColumn Header="ZTop Host" Binding="{Binding ZTopHostDisplay}" Width="110"/>
                <DataGridTextColumn Header="ZTop Link" Binding="{Binding ZTopLinkDisplay}" Width="110"/>
                <DataGridTextColumn Header="Delta Z" Binding="{Binding DeltaZDisplay}" Width="90"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="110"/>
                <DataGridTextColumn Header="Message" Binding="{Binding ErrorMessage}" Width="220"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="#000000"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="#FEE2E2"/>
                            <Setter Property="Foreground" Value="#991B1B"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsNoMatch}" Value="True">
                            <Setter Property="Background" Value="#E0E7FF"/>
                            <Setter Property="Foreground" Value="#3730A3"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <Rectangle Grid.Row="7" Height="1" Fill="#D1D5DB" Margin="0,4"/>

        <!-- ── ACTION BUTTONS ── -->
        <Grid Grid.Row="8" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock x:Name="TxtStatusBar" Grid.Column="0" Foreground="#000000" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"/>
            
            <UniformGrid Grid.Column="1" Rows="1" HorizontalAlignment="Right">
                <Button x:Name="BtnRun" Content="▶  Run Check" Click="BtnRun_Click" Style="{StaticResource PrimaryBtn}" Margin="6,0,0,0"/>
                <Button x:Name="BtnShow3D" Content="👁  Show 3D" Click="BtnShow3D_Click" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0" IsEnabled="False"/>
                <Button x:Name="BtnApplyColor" Content="🎨  Apply Color" Click="BtnApplyColor_Click" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0" IsEnabled="False"/>
                <Button x:Name="BtnExportHtml" Content="📄  Export HTML" Click="BtnExportHtml_Click" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0" IsEnabled="False"/>
                <Button x:Name="Btn3DPen" Content="🖊  3D Pen" Click="Btn3DPen_Click" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0" IsEnabled="True"/>
                <Button x:Name="BtnResetColor" Content="✖  Reset Color" Click="BtnResetColor_Click" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0" IsEnabled="False"/>
            </UniformGrid>
            <TextBlock Text="@manhns" Margin="0,40,0,-8" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280" Opacity="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False" Focusable="False"/>
        </Grid>
    </Grid>
</Window>



