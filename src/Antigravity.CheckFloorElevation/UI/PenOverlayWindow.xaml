<Window x:Class="Antigravity.CheckFloorElevation.UI.PenOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Antigravity.Core.UI.Controls;assembly=Antigravity.Core"
        Title="Vilai Viet - 3D Pen Overlay"
        AllowsTransparency="True" Background="#01000000" WindowStyle="None" Topmost="True"
        ShowInTaskbar="False">
<Grid>
<InkCanvas x:Name="PenCanvas" Background="Transparent" />
<Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0" Background="#DD202226" CornerRadius="8" Padding="15,10">
<StackPanel Orientation="Horizontal">
<TextBlock Text="✏️ 3D Pen Active" Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0" FontWeight="Bold" FontSize="16"/>
<ComboBox x:Name="CmbColors" Width="100" Margin="0,0,10,0" SelectionChanged="CmbColors_SelectionChanged">
<ComboBoxItem Content="Red" Tag="#FF0000" IsSelected="True"/>
<ComboBoxItem Content="Green" Tag="#00FF00"/>
<ComboBoxItem Content="Blue" Tag="#0000FF"/>
<ComboBoxItem Content="Yellow" Tag="#FFFF00"/>
<ComboBoxItem Content="White" Tag="#FFFFFF"/>
</ComboBox>
<Button Content="Undo" Click="Undo_Click" Margin="0,0,10,0" Padding="15,5" Background="#333333" Foreground="White" BorderThickness="0"/>
<Button Content="Clear" Click="Clear_Click" Margin="0,0,20,0" Padding="15,5" Background="#333333" Foreground="White" BorderThickness="0"/>
<Button Content="Done" Click="Done_Click" Background="#2E7D32" Foreground="White" Padding="25,5" FontWeight="Bold" BorderThickness="0"/>
<Button Content="Cancel" Click="Cancel_Click" Margin="10,0,0,0" Padding="15,5" Background="#C62828" Foreground="White" BorderThickness="0"/>
</StackPanel>
</Border>
<TextBlock Text="@manhns" FontSize="16" FontWeight="Bold" Foreground="#9BA3AF" Opacity="0.8" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False" Margin="0,0,16,16"/>
</Grid>
</Window>
