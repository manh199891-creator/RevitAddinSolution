<Window x:Class="Antigravity.ZoneSplit.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vilai Viet ZoneSplit - Phân chia khối lượng" 
        Width="450" Height="400"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        ResizeMode="CanResize"
        Topmost="True" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True" MinWidth="420" MinHeight="360">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Typography.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DataControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="Border" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16,16,16,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="10"/>   <!-- Space -->
            <RowDefinition Height="Auto"/> <!-- Category Label -->
            <RowDefinition Height="Auto"/> <!-- Category Options -->
            <RowDefinition Height="10"/>   <!-- Space -->
            <RowDefinition Height="Auto"/> <!-- Options Label -->
            <RowDefinition Height="Auto"/> <!-- Options -->
            <RowDefinition Height="*"/>    <!-- Spacer -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1" Margin="-16,-16,-16,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Canvas Width="100" Height="80">
                        <Path Fill="#1B3679" Data="M 30,10 L 70,10 L 50,45 Z"/>
                        <Path Fill="#D8262C" Data="M 10,10 L 32,10 L 50,55 L 68,10 L 90,10 L 50,80 Z"/>
                    </Canvas>
                </Viewbox>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#111827">
                        <Run Text="VILA" Foreground="#1B3679"/><Run Text="I"><Run.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#1B3679" Offset="0.7"/><GradientStop Color="#D8262C" Offset="0.7"/></LinearGradientBrush></Run.Foreground></Run><Run Text="VIET" Foreground="#D8262C"/><Run Text=" · AUTO ZONE SPLIT" Foreground="#111827" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock Text="Volume calculation based on Zone Generic Models" 
                               FontSize="11" Foreground="#6B7280" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SEPARATOR -->
        <Rectangle Grid.Row="1" Fill="#D1D5DB" Height="1" Margin="0,4"/>

        <!-- CATEGORIES -->
        <TextBlock Grid.Row="2" Style="{StaticResource HeaderStyle}" FontSize="12" Text="Chọn cấu kiện tính toán khối lượng:" Margin="0,10,0,5"/>
        
        <Border Grid.Row="3" Background="#F5F6F8" CornerRadius="4" Padding="15">
            <StackPanel>
                <CheckBox Name="chkAll" Content="Chọn tất cả" IsChecked="True" FontWeight="Bold" Checked="ChkAll_Checked" Unchecked="ChkAll_Unchecked"/>
                <Rectangle Fill="#D1D5DB" Height="1" Margin="0,5"/>
                <CheckBox Name="chkColumns" Content="Cột kết cấu (Structural Columns)" IsChecked="True" Checked="ChkItem_Changed" Unchecked="ChkItem_Changed"/>
                <CheckBox Name="chkFraming" Content="Dầm kết cấu (Structural Framing)" IsChecked="True" Checked="ChkItem_Changed" Unchecked="ChkItem_Changed"/>
                <CheckBox Name="chkFloors" Content="Sàn (Floors)" IsChecked="True" Checked="ChkItem_Changed" Unchecked="ChkItem_Changed"/>
                <CheckBox Name="chkWalls" Content="Vách/Tường (Walls)" IsChecked="True" Checked="ChkItem_Changed" Unchecked="ChkItem_Changed"/>
                <CheckBox Name="chkFoundation" Content="Móng (Structural Foundation)" IsChecked="True" Checked="ChkItem_Changed" Unchecked="ChkItem_Changed"/>
            </StackPanel>
        </Border>

        <!-- OPTIONS -->
        <TextBlock Grid.Row="5" Style="{StaticResource HeaderStyle}" FontSize="12" Text="Phương thức xử lý:" Margin="0,10,0,5"/>
        <Border Grid.Row="6" Background="#F5F6F8" CornerRadius="4" Padding="15">
            <StackPanel>
                <RadioButton Name="optDataOnly" Content="Chỉ tính Volume và gán BIM_Volume (Không cắt)" IsChecked="True"/>
                <RadioButton Name="optParts" Content="Tạo Parts và gán Parameter tự động (Khuyên dùng cho 4D)"/>
                <RadioButton Name="optPhysical" Content="Cắt Vật lý - Copy &amp; Adjust (Chỉ Tường/Dầm, Mất Rebar)"/>
            </StackPanel>
        </Border>

        <!-- ACTION BUTTONS -->
        <Grid Grid.Row="8" Margin="0,15,0,0">
            <UniformGrid Rows="1">
                <Button Style="{StaticResource PrimaryBtn}" Content="▶  XỬ LÝ ZONE" Click="BtnProcess_Click"/>
                <Button Content="✖  CANCEL" Click="BtnCancel_Click" Style="{StaticResource SecondaryBtn}"/>
            </UniformGrid>
            <TextBlock Text="@manhns" Margin="0,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280" Opacity="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False" Focusable="False"/>
        </Grid>
    </Grid>
</Window>

