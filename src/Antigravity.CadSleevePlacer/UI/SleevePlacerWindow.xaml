<Window x:Class="Antigravity.CadSleevePlacer.UI.SleevePlacerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Antigravity.Core.UI.Controls;assembly=Antigravity.Core"
        Title="Vilai Viet Tạo Lỗ Mở Dầm/Vách từ CAD" Height="700" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF" FontFamily="Segoe UI"
        Loaded="Window_Loaded" UseLayoutRounding="True" SnapsToDevicePixels="True" ResizeMode="CanResize" MinWidth="440" MinHeight="520">

        <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Typography.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DataControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#000000"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding"      Value="6,2"/>
            <Setter Property="BorderBrush"  Value="#D1D5DB"/>
            <Setter Property="Background"   Value="#FFFFFF"/>
            <Setter Property="Foreground"   Value="#000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="Border" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Default button (Secondary) -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D1D5DB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#9BA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4" Background="{TemplateBinding Background}" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3399FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#005C99"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground"  Value="#007ACC"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Padding"     Value="0,0,0,4"/>
        </Style>
    </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1" Margin="-24,-24,-24,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Canvas Width="100" Height="80">
                        <Path Fill="#1B3679" Data="M 30,10 L 70,10 L 50,45 Z"/>
                        <Path Fill="#D8262C" Data="M 10,10 L 32,10 L 50,55 L 68,10 L 90,10 L 50,80 Z"/>
                    </Canvas>
                </Viewbox>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#111827">
                        <Run Text="VILA" Foreground="#1B3679"/><Run Text="I"><Run.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#1B3679" Offset="0.7"/><GradientStop Color="#D8262C" Offset="0.7"/></LinearGradientBrush></Run.Foreground></Run><Run Text="VIET" Foreground="#D8262C"/><Run Text=" · ĐẶT SLEEVE TỪ CAD" Foreground="#111827" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock Text="Đọc Leader, Text từ AutoCAD để đặt Family Sleeve tự động" 
                               FontSize="11" Foreground="#6B7280" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ── Step 1: Regex Settings ───────────────────────────── -->
                <Label Content="1 · REGEX CẤU HÌNH NHẬN DIỆN"/>
                <TextBlock Text="Biểu thức chính quy (Regex) để trích xuất đường kính (DN) và cao độ (COP) từ chuỗi Text AutoCAD."
                           FontSize="11" Foreground="#888888" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="DN (vd: DN125)" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtRegexDN" Text="[Dd][Nn]?\s*(\d+)"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="WxH (vd: 900x400)" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtRegexRect" Text="(\d+)\s*[xX]\s*(\d+)"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="COP/BOO (vd: FL+3050)" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtRegexCOP" Text="FL([+-]?\d+)"/>
                    </StackPanel>
                </Grid>

                <!-- ── Step 2: Select geometry ───────────────────────────── -->
                <Label Content="2 · CHỌN LAYER &amp; QUÉT VÙNG CAD"/>
                <TextBlock Text="Chọn Layer sleeve (hoặc bấm ... chọn đối tượng mẫu), sau đó quét chọn phạm vi làm việc trên CAD."
                           FontSize="11" Foreground="#888888" Margin="0,0,0,8" TextWrapping="Wrap"/>
                
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ComboLayers" VerticalContentAlignment="Center" Margin="0,0,8,0" Height="28"/>
                    <Button Grid.Column="1" x:Name="BtnPickLayer" Content="..." Width="40" Height="28"
                            Style="{StaticResource PrimaryBtn}" FontSize="14" FontWeight="Bold"
                            Click="BtnPickLayer_Click" ToolTip="Chọn đối tượng mẫu trên CAD để tự lấy Layer"/>
                </Grid>

                <Button x:Name="BtnScanRegion" Content="Quét chọn phạm vi làm việc trên CAD"
                        HorizontalAlignment="Stretch" Height="38" Margin="0,0,0,10"
                        Style="{StaticResource PrimaryBtn}" FontSize="13" FontWeight="Bold"
                        Click="BtnScanRegion_Click"/>

                <TextBlock x:Name="TxtSelStatus"
                           Text="Chưa có dữ liệu nào được chọn."
                           FontSize="11" Foreground="#FF9999" FontStyle="Italic"
                           Margin="0,0,0,20" TextWrapping="Wrap"/>

                <!-- ── Step 3: ĐỒNG NHẤT TOẠ ĐỘ ───────────────────────── -->
                <Label Content="3 · ĐỒNG NHẤT TOẠ ĐỘ (ORIGIN POINT)"/>
                <TextBlock Text="Thiết lập điểm gốc giống nhau giữa Revit và CAD để đồng bộ tọa độ."
                           FontSize="11" Foreground="#888888" Margin="0,0,0,8" TextWrapping="Wrap"/>
                
                <Button x:Name="BtnSetOrigin" Content="Set Coordinate Origin (Revit ↔ CAD)"
                        HorizontalAlignment="Left" Padding="14,8" Margin="0,0,0,6"
                        Click="BtnSetOrigin_Click"/>
                <TextBlock x:Name="TxtRevitStatus"
                           Text="Chưa đồng bộ tọa độ."
                           FontSize="11" Foreground="#FF9999" FontStyle="Italic"
                           Margin="0,0,0,20"/>

                <!-- ── Step 4: Select Family & Level ────────────────────────────────── -->
                <Label Content="4 · FAMILY VÀ LEVEL"/>
                <TextBlock Text="Chọn Level gốc và Family Sleeve (Generic Model) để đặt."
                           FontSize="11" Foreground="#888888" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <TextBlock Text="Base Level:" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                <ComboBox x:Name="ComboLevels" DisplayMemberPath="Name" Margin="0,0,0,10"
                          VerticalContentAlignment="Center"/>
                
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Family Sleeve (Generic Model):" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ComboFamilies" DisplayMemberPath="Name" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Chiều dài (mm):" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtDefaultLength" Text="300"/>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <StackPanel>
                <Separator Background="#E5E7EB" Margin="0,0,0,14"/>
                <Button Content="PLACE SLEEVES" Height="46" FontSize="15" FontWeight="Bold"
                        Style="{StaticResource PrimaryBtn}"
                        Click="BtnProcess_Click" Cursor="Hand"/>
            </StackPanel>
            <TextBlock Text="@manhns" Margin="0,0,0,-8" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280" Opacity="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False" Focusable="False"/>
        </Grid>
    </Grid>
</Window>



