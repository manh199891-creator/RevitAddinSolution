<Window x:Class="DoorClearanceBox.UI.ClearanceBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Antigravity.Core.UI.Controls;assembly=Antigravity.Core"
        Title="Vilai Viet - Tạo Khối Khoảng Mở Cửa"
        Width="820" Height="620"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF"
        Loaded="Window_Loaded" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True" MinWidth="720" MinHeight="520">
    
        <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Typography.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DataControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- Colors -->
        <Color x:Key="BgPrimary">#FFFFFF</Color>
        <Color x:Key="BgSecondary">#F5F6F8</Color>
        <Color x:Key="PrimaryBtnColor">#007ACC</Color>
        <Color x:Key="PrimaryBtnHover">#005A9E</Color>
        <Color x:Key="SecondaryBtnColor">#E5E7EB</Color>
        <Color x:Key="AccentYellow">#000000</Color>
        <Color x:Key="SeparatorColor">#D1D5DB</Color>
        
        <SolidColorBrush x:Key="BgPrimaryBrush" Color="{StaticResource BgPrimary}"/>
        <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondary}"/>
        <SolidColorBrush x:Key="PrimaryBtnBrush" Color="{StaticResource PrimaryBtnColor}"/>
        <SolidColorBrush x:Key="SecondaryBtnBrush" Color="{StaticResource SecondaryBtnColor}"/>
        <SolidColorBrush x:Key="AccentYellowBrush" Color="{StaticResource AccentYellow}"/>
        <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource SeparatorColor}"/>
        
        <!-- Styles -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource VvTextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource VvTextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBtnBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{StaticResource SecondaryBtnBrush}"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>
        
        <!-- Checkbox / RadioButton dark mode styles -->
        <Style x:Key="DarkCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource VvTextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style x:Key="DarkRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource VvTextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </ResourceDictionary>
    </Window.Resources>
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header -->
            <RowDefinition Height="10"/>   <!-- 1: Separator -->
            <RowDefinition Height="*"/>    <!-- 2: Content (ScrollViewer) -->
            <RowDefinition Height="10"/>   <!-- 3: Separator -->
            <RowDefinition Height="Auto"/> <!-- 4: Action Buttons -->
        </Grid.RowDefinitions>
        
        <!-- HEADER -->
        <controls:BrandHeader x:Name="WindowHeader" Grid.Row="0" TitleText="Tạo Khối Khoảng Mở Cửa" SubtitleText="Create clearance boxes for doors/windows."/>
        
        <Rectangle Grid.Row="1" Fill="{StaticResource SeparatorBrush}" Height="1"/>
        
        <!-- CONTENT -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="SCOPE" Style="{StaticResource HeaderStyle}" Foreground="{StaticResource AccentYellowBrush}"/>
                
                <RadioButton x:Name="RbActiveView" Content="Active view only" GroupName="ScopeGroup" Style="{StaticResource DarkRadio}" IsChecked="True" Checked="Scope_Changed"/>
                <RadioButton x:Name="RbEntireModel" Content="Entire model" GroupName="ScopeGroup" Style="{StaticResource DarkRadio}" Checked="Scope_Changed"/>
                
                <CheckBox x:Name="ChkSelectLevel" Content="By Level" Style="{StaticResource DarkCheck}" Checked="Scope_Changed" Unchecked="Scope_Changed"/>
                <ListBox x:Name="LstLevels" Margin="20,4,0,8" Height="100" Background="{StaticResource BgSecondaryBrush}" Foreground="#000000" SelectionMode="Multiple"
                         Visibility="Collapsed"
                         SelectionChanged="Lst_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Name}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                
                <CheckBox x:Name="ChkSelectLink" Content="From Link" Style="{StaticResource DarkCheck}" Checked="Scope_Changed" Unchecked="Scope_Changed"/>
                <ComboBox x:Name="CboLinks" Margin="20,4,0,4" Height="28" 
                          Visibility="Collapsed"
                          SelectionChanged="CboLinks_SelectionChanged"/>
                
                <ListBox x:Name="LstLinkLevels" Margin="20,4,0,8" Height="100" Background="{StaticResource BgSecondaryBrush}" Foreground="#000000" SelectionMode="Multiple"
                         Visibility="Collapsed"
                         SelectionChanged="Lst_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Name}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                
                <Rectangle Fill="{StaticResource SeparatorBrush}" Height="1" Margin="0,10"/>
                
                <TextBlock Text="CATEGORIES" Style="{StaticResource HeaderStyle}" Foreground="{StaticResource AccentYellowBrush}"/>
                
                <CheckBox x:Name="ChkDoors" Content="Doors" Style="{StaticResource DarkCheck}" IsChecked="True" Checked="Category_Changed" Unchecked="Category_Changed"/>
                <ListBox x:Name="LstDoorTypes" Margin="20,2,0,6" MaxHeight="100" Background="{StaticResource BgSecondaryBrush}" Foreground="#000000" SelectionMode="Multiple"
                         Visibility="Collapsed" SelectionChanged="TypeFilter_Changed">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                
                <CheckBox x:Name="ChkWindows" Content="Windows" Style="{StaticResource DarkCheck}" IsChecked="True" Checked="Category_Changed" Unchecked="Category_Changed"/>
                <ListBox x:Name="LstWindowTypes" Margin="20,2,0,6" MaxHeight="100" Background="{StaticResource BgSecondaryBrush}" Foreground="#000000" SelectionMode="Multiple"
                         Visibility="Collapsed" SelectionChanged="TypeFilter_Changed">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                
                <CheckBox x:Name="ChkCurtainPanels" Content="Curtain Panels" Style="{StaticResource DarkCheck}" IsChecked="False" Checked="Category_Changed" Unchecked="Category_Changed"/>
                <ListBox x:Name="LstCurtainPanelTypes" Margin="20,2,0,6" MaxHeight="100" Background="{StaticResource BgSecondaryBrush}" Foreground="#000000" SelectionMode="Multiple"
                         Visibility="Collapsed" SelectionChanged="TypeFilter_Changed">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <CheckBox x:Name="ChkCurtainWalls" Content="Curtain Walls" Style="{StaticResource DarkCheck}" IsChecked="False" Checked="Category_Changed" Unchecked="Category_Changed"/>
                <ListBox x:Name="LstCurtainWallTypes" Margin="20,2,0,6" MaxHeight="100" Background="{StaticResource BgSecondaryBrush}" Foreground="#000000" SelectionMode="Multiple"
                         Visibility="Collapsed" SelectionChanged="TypeFilter_Changed">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                
                <Rectangle Fill="{StaticResource SeparatorBrush}" Height="1" Margin="0,10"/>
                
                <TextBlock Text="GEOMETRY TYPE" Style="{StaticResource HeaderStyle}" Foreground="{StaticResource AccentYellowBrush}"/>
                <RadioButton x:Name="RbRect" Content="Rectangle (Hbox = H, Lbox = 2L)" GroupName="GeomGroup" Style="{StaticResource DarkRadio}" IsChecked="True"/>
                <RadioButton x:Name="RbEllipse" Content="Ellipse (a = H, b = 2L)" GroupName="GeomGroup" Style="{StaticResource DarkRadio}"/>
                
                <Rectangle Fill="{StaticResource SeparatorBrush}" Height="1" Margin="0,10"/>
                
                <TextBlock Text="OPTIONS" Style="{StaticResource HeaderStyle}" Foreground="{StaticResource AccentYellowBrush}"/>
                <CheckBox x:Name="ChkTagIfc" Content="Tag as IfcSpace (sets IfcExportAs parameter)" Style="{StaticResource DarkCheck}" IsChecked="True"/>
                <CheckBox x:Name="ChkSkipExisting" Content="Skip if clearance box already exists (avoid duplicates)" Style="{StaticResource DarkCheck}" IsChecked="True"/>
                
                <Rectangle Fill="{StaticResource SeparatorBrush}" Height="1" Margin="0,10"/>
                
                <TextBlock Text="STATUS" Style="{StaticResource HeaderStyle}" Foreground="{StaticResource AccentYellowBrush}"/>
                <TextBlock x:Name="TxtStatus" Style="{StaticResource LabelStyle}" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtSubStatus" Style="{StaticResource LabelStyle}" Foreground="#AAAAAA" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Total: " Style="{StaticResource LabelStyle}"/>
                    <TextBlock x:Name="TxtCount" Text="—" Style="{StaticResource HeaderStyle}"/>
                </StackPanel>
                
                <Border x:Name="PanelProgress" Visibility="Collapsed" Margin="0,10,0,0">
                    <StackPanel>
                        <ProgressBar x:Name="ProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Background="{StaticResource BgSecondaryBrush}" Foreground="{StaticResource AccentYellowBrush}" BorderThickness="0"/>
                        <TextBlock x:Name="TxtProgress" Style="{StaticResource LabelStyle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
        <Rectangle Grid.Row="3" Fill="{StaticResource SeparatorBrush}" Height="1"/>
        
        <!-- ACTION BUTTONS -->
        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="X Cancel" Grid.Column="0" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Click="BtnCancel_Click"/>
            <Button x:Name="BtnUndraw" Content="- Undraw" Grid.Column="1" Style="{StaticResource GhostButton}" Margin="4,0,4,0" Click="BtnUndraw_Click"/>
            <Button x:Name="BtnCreate" Content="+ Draw Rect" Grid.Column="2" Style="{StaticResource PrimaryBtn}" Margin="4,0,0,0" Click="BtnCreate_Click"/>
            <controls:BrandSignature Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>


