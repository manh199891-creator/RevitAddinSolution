<Window x:Class="DoorClearanceBox.UI.ClashControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Antigravity.Core.UI.Controls;assembly=Antigravity.Core"
        Title="Vilai Viet - Kiểm Soát Xung Đột Khoảng Mở Cửa"
        Width="850" Height="550"
        MinHeight="440" MinWidth="780"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF"
        Loaded="Window_Loaded" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">

        <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Typography.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DataControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <!-- Colors -->
        <Color x:Key="BgPrimary">#FFFFFF</Color>
        <Color x:Key="BgSecondary">#F5F6F8</Color>
        <Color x:Key="PrimaryBtnColor">#007ACC</Color>
        <Color x:Key="PrimaryBtnHover">#005A9E</Color>
        <Color x:Key="SecondaryBtnColor">#E5E7EB</Color>
        <Color x:Key="AccentYellow">#FFD700</Color>
        <Color x:Key="SeparatorColor">#D1D5DB</Color>

        <SolidColorBrush x:Key="BgPrimaryBrush" Color="{StaticResource BgPrimary}"/>
        <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondary}"/>
        <SolidColorBrush x:Key="PrimaryBtnBrush" Color="{StaticResource PrimaryBtnColor}"/>
        <SolidColorBrush x:Key="SecondaryBtnBrush" Color="{StaticResource SecondaryBtnColor}"/>
        <SolidColorBrush x:Key="AccentYellowBrush" Color="{StaticResource AccentYellow}"/>
        <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource SeparatorColor}"/>

        <!-- Styles -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource VvTextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="NormalText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="AccentText" TargetType="TextBlock" BasedOn="{StaticResource NormalText}">
            <Setter Property="Foreground" Value="{StaticResource AccentYellowBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBtnBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{StaticResource SecondaryBtnBrush}"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>
    </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header -->
            <RowDefinition Height="10"/>   <!-- 1: Separator -->
            <RowDefinition Height="*"/>    <!-- 2: Clash List Grid -->
            <RowDefinition Height="10"/>   <!-- 3: Separator -->
            <RowDefinition Height="Auto"/> <!-- 4: Status & Action Bar -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <controls:BrandHeader Grid.Row="0" TitleText="Kiểm Soát Xung Đột Khoảng Mở Cửa" SubtitleText="Phát hiện và quản lý các giao cắt hình học giữa Khoảng mở cửa (Clearance Box) và Cấu kiện kết cấu."/>

        <Rectangle Grid.Row="1" Fill="{StaticResource SeparatorBrush}" Height="1"/>

        <!-- CONTENT: Clash List Grid -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Clashes DataGrid -->
            <DataGrid x:Name="GridClashes" Grid.Row="0" AutoGenerateColumns="False" 
                      Background="{StaticResource BgSecondaryBrush}" Foreground="#000000" 
                      BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource SeparatorBrush}"
                      RowBackground="{StaticResource BgSecondaryBrush}" AlternatingRowBackground="#FFFFFF"
                      HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                      IsReadOnly="True" RowHeaderWidth="0">
                <DataGrid.Resources>
                    <!-- Header Style -->
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#3E3E42" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}"/>
                    </Style>
                    <!-- Row Style -->
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="28"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryBtnBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mark Cửa" Binding="{Binding DoorMark}" Width="80"/>
                    <DataGridTextColumn Header="Tên Cửa / Window" Binding="{Binding DoorName}" Width="*"/>
                    <DataGridTextColumn Header="ID Cửa" Binding="{Binding DoorId.Value}" Width="90"/>
                    
                    <DataGridTextColumn Header="Cấu Kiện Xung Đột" Binding="{Binding ClashingCategory}" Width="150"/>
                    <DataGridTextColumn Header="Tên Cấu Kiện" Binding="{Binding ClashingName}" Width="1.5*"/>
                    <DataGridTextColumn Header="ID Cấu Kiện" Binding="{Binding ClashingElementId.Value}" Width="90"/>
                    
                    <DataGridTextColumn Header="Thể Tích Giao (m³)" Binding="{Binding ClashingVolumeM3}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Loading overlay / No-results prompt -->
            <TextBlock x:Name="TxtNoClashes" Grid.Row="0" Text="Nhấn 'QUÉT XUNG ĐỘT' để bắt đầu phân tích mô hình..." 
                       Style="{StaticResource NormalText}" Foreground="#AAAAAA"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" IsHitTestVisible="False"/>
        </Grid>

        <Rectangle Grid.Row="3" Fill="{StaticResource SeparatorBrush}" Height="1"/>

        <!-- STATUS & ACTION BAR -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Status / Stats -->
                <ColumnDefinition Width="*"/>    <!-- Spacer -->
                <ColumnDefinition Width="Auto"/> <!-- Action Buttons -->
                <ColumnDefinition Width="Auto"/> <!-- Signature -->
            </Grid.ColumnDefinitions>

            <!-- Stats Left -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Tổng số xung đột phát hiện: " Style="{StaticResource NormalText}"/>
                <TextBlock x:Name="TxtTotalClashes" Text="0" Style="{StaticResource AccentText}"/>
            </StackPanel>

            <!-- Buttons Right -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnScan" Content="QUÉT XUNG ĐỘT" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" Click="BtnScan_Click"/>
                <Button x:Name="BtnShow" Content="ZOOM XEM CHỖ GIAO" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="BtnShow_Click" IsEnabled="False"/>
                <Button x:Name="BtnExport" Content="XUẤT EXCEL (CSV)" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="BtnExport_Click" IsEnabled="False"/>
                <Button x:Name="BtnClose" Content="ĐÓNG" Style="{StaticResource SecondaryBtn}" Click="BtnClose_Click"/>
            </StackPanel>
            <controls:BrandSignature Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>


