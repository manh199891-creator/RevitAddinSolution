<Window x:Class="Antigravity.HoanThien.UI.HoanThienWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Antigravity.Core.UI.Controls;assembly=Antigravity.Core"
        Title="Vilai Viet Lớp Hoàn Thiện - build 2026-07-09" Height="600" MinHeight="480" Width="760"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF" Topmost="True" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True" ResizeMode="CanResize" MinWidth="680">

        <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Typography.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DataControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="Border" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Brand Header -->
        <controls:BrandHeader Grid.Row="0" TitleText="Lớp Hoàn Thiện - build 2026-07-09" SubtitleText="Tạo lớp trát, ốp, sơn, sàn tự động theo Room"/>

        <!-- Content Area -->
        <Border Grid.Row="2" Background="#F5F6F8" Padding="20">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#4B5563"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Margin" Value="0,0,10,0"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#007ACC"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Resources>

                <!-- TAB ROOMS -->
                <TabItem Header="Rooms">
                    <Grid Margin="0,15,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Content from old UI -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                            <CheckBox Content="Áp dụng cho các Room đang chọn (Pre-selection)" Foreground="#000000" IsChecked="{Binding UsePreSelection}" VerticalAlignment="Center" FontSize="13" FontWeight="Medium"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Lọc theo Room:" Width="120" Foreground="#4B5563" VerticalAlignment="Center"/>
                            <Grid Width="300">
                                <ToggleButton x:Name="RoomDropdownToggle" Content="{Binding SelectedRoomsSummary}" HorizontalContentAlignment="Left" Background="#FFFFFF" Foreground="#000000" BorderBrush="#D1D5DB" BorderThickness="1" Height="28" Padding="8,0"/>
                                <Popup IsOpen="{Binding IsChecked, ElementName=RoomDropdownToggle}" StaysOpen="False" PlacementTarget="{Binding ElementName=RoomDropdownToggle}" Width="{Binding ActualWidth, ElementName=RoomDropdownToggle}">
                                    <Border Background="#F5F6F8" BorderBrush="#D1D5DB" BorderThickness="1">
                                        <ListBox ItemsSource="{Binding AvailableRoomNames}" MaxHeight="200" Background="Transparent" BorderThickness="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Foreground="#000000" Margin="4"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>

                        <Separator Grid.Row="2" Background="#D1D5DB" Margin="0,6"/>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
                            <CheckBox Content="Tạo Vách (Wall)" Foreground="#000000" IsChecked="{Binding Config.CreateWall}" VerticalAlignment="Center" Margin="0,0,24,0"/>
                            <TextBlock Text="Wall Type:" Width="60" Foreground="#4B5563" VerticalAlignment="Center"/>
                            <ComboBox Width="240" ItemsSource="{Binding AvailableWallTypes}" SelectedItem="{Binding SelectedWallType}" DisplayMemberPath="Name" Background="#FFFFFF" Foreground="#000000"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,12">
                            <CheckBox Content="Tạo Sàn (Floor)" Foreground="#000000" IsChecked="{Binding Config.CreateFloor}" VerticalAlignment="Center" Margin="0,0,24,0"/>
                            <TextBlock Text="Floor Type:" Width="60" Foreground="#4B5563" VerticalAlignment="Center"/>
                            <ComboBox Width="240" ItemsSource="{Binding AvailableFloorTypes}" SelectedItem="{Binding SelectedFloorType}" DisplayMemberPath="Name" Background="#FFFFFF" Foreground="#000000"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- TAB RULES -->
                <TabItem Header="Rules">
                    <Grid Margin="0,15,0,0">
                        <TextBlock Text="JSON Rule Engine sẽ được cấu hình tại đây." Foreground="#4B5563"/>
                    </Grid>
                </TabItem>

                <!-- TAB OPTIONS -->
                <TabItem Header="Options">
                    <Grid Margin="0,15,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <CheckBox Content="Loại trừ vách kính (Curtain Wall)" Foreground="#000000" IsChecked="{Binding Config.ExcludeCurtainWalls}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Offset lên trần (mm):" Width="120" Foreground="#4B5563" VerticalAlignment="Center"/>
                                <TextBox Width="100" Text="{Binding Config.HeightOffsetAboveCeilingMm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                            </StackPanel>

                            <Separator Background="#D1D5DB" Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <CheckBox Content="Đánh mã phòng tự động" Foreground="#000000" IsChecked="{Binding Config.EnableRoomCoding}" VerticalAlignment="Center" Margin="0,0,24,0"/>
                                <TextBlock Text="Tiền tố (Prefix):" Width="90" Foreground="#4B5563" VerticalAlignment="Center"/>
                                <TextBox Width="100" Text="{Binding Config.RoomCodePrefix, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="Dùng Shared Parameter (AG_...) thay vì Mặc định" Foreground="#000000" IsChecked="{Binding Config.UseSharedParameters}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- TAB PREVIEW -->
                <TabItem Header="Preview">
                    <Grid Margin="0,15,0,0">
                        <TextBlock Text="Cây phân tích Substrate/Ceiling sẽ hiển thị tại đây." Foreground="#4B5563"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Bottom Action Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Check Phòng Trống" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="BtnCheckRooms_Click"/>
                <Button Content="Tạo Hoàn Thiện" Style="{StaticResource PrimaryBtn}" Click="BtnOk_Click"/>
                <Button Content="Hủy" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0" Click="BtnCancel_Click"/>
            </StackPanel>
            
            <controls:BrandSignature Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>


