<Window x:Class="Antigravity.SharedParamMapper.Views.ParamMapperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Antigravity.Core.UI.Controls;assembly=Antigravity.Core"
        xmlns:models="clr-namespace:Antigravity.SharedParamMapper.Models"
        mc:Ignorable="d"
        Title="Shared Parameter Mapper" Height="600" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource VvSurfaceBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DesignTokens.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Typography.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DataControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <controls:BrandHeader TitleText="Shared Parameter Mapper" Grid.Row="0" Margin="0,0,0,15"/>

        <!-- Filters -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource VvTextPrimaryBrush}"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCategory}" Style="{StaticResource VvComboBoxStyle}"/>

                <TextBlock Grid.Column="2" Text="Family Type:" VerticalAlignment="Center" Margin="20,0,10,0" Foreground="{DynamicResource VvTextPrimaryBrush}"/>
                <ComboBox Grid.Column="3" ItemsSource="{Binding FamilyTypes}" 
                          IsEditable="True" IsReadOnly="True" Text="{Binding SelectedFamilyTypesText, Mode=OneWay}"
                          Style="{StaticResource VvComboBoxStyle}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="FamilyTypeCheckBox_Click" Foreground="{DynamicResource VvTextPrimaryBrush}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            
            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                <TextBlock Text="Apply to:" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="{DynamicResource VvTextPrimaryBrush}"/>
                <RadioButton Content="All instances" IsChecked="{Binding ApplyToAll}" Margin="0,0,15,0" Foreground="{DynamicResource VvTextPrimaryBrush}"/>
                <RadioButton Content="Selected elements only" IsChecked="{Binding ApplyToSelected}" Foreground="{DynamicResource VvTextPrimaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding ParamRows}" AutoGenerateColumns="False" CanUserAddRows="False" 
                  Style="{StaticResource VvDataGridStyle}" Background="{DynamicResource VvSurfaceBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Parameter" Binding="{Binding ParamName}" Width="250" IsReadOnly="True"/>
                
                <DataGridTemplateColumn Header="Mapped Value" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox IsEditable="True" 
                                      ItemsSource="{Binding AvailableSourceParams}" 
                                      Text="{Binding MappedValue, UpdateSourceTrigger=PropertyChanged}" 
                                      Style="{StaticResource VvComboBoxStyle}" Padding="2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{DynamicResource VvAccentBrush}" Margin="0,10,0,10"/>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Export Template" Command="{Binding ExportCommand}" Style="{StaticResource VvSecondaryButtonStyle}" Margin="0,0,10,0" Width="120"/>
                <Button Content="Import Template" Command="{Binding ImportCommand}" Style="{StaticResource VvSecondaryButtonStyle}" Margin="0,0,10,0" Width="120"/>
                <Button Content="Load SP File" Command="{Binding LoadTxtCommand}" Style="{StaticResource VvSecondaryButtonStyle}" Margin="0,0,10,0" Width="120" ToolTip="Load parameters from Shared Parameter TXT file"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Sync Params" Command="{Binding SyncCommand}" Style="{StaticResource VvPrimaryButtonStyle}" Margin="0,0,10,0" Width="120"/>
                <Button Content="Close" Click="BtnClose_Click" Style="{StaticResource VvSecondaryButtonStyle}" Width="80"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
