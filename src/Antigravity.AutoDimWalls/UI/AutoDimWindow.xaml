<Window x:Class="Antigravity.AutoDimWalls.UI.AutoDimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Antigravity.Core.UI.Controls;assembly=Antigravity.Core"
        Title="Vilai Viet AutoDim"
        Width="620" Height="520" MinWidth="560" MinHeight="460"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="#FFFFFF" Foreground="#000000" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Typography.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Antigravity.Core;component/UI/Themes/DataControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="Border" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Brand Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1" Margin="-16,-16,-16,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Canvas Width="100" Height="80">
                        <Path Fill="#1B3679" Data="M 30,10 L 70,10 L 50,45 Z"/>
                        <Path Fill="#D8262C" Data="M 10,10 L 32,10 L 50,55 L 68,10 L 90,10 L 50,80 Z"/>
                    </Canvas>
                </Viewbox>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="14" FontWeight="Bold">
                        <Run Text="VILA" Foreground="#1B3679"/>
                        <Run Text="I">
                            <Run.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#1B3679" Offset="0.7"/>
                                    <GradientStop Color="#D8262C" Offset="0.7"/>
                                </LinearGradientBrush>
                            </Run.Foreground>
                        </Run>
                        <Run Text="VIET" Foreground="#D8262C"/>
                        <Run Text=" · AutoDim Walls" Foreground="#111827" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock Text="Create chained dimensions for straight architectural walls in the active view." Foreground="#6B7280" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2">
            <!-- View Type Selection -->
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="View Type" Style="{StaticResource HeaderStyle}" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RadViewPlan" Content="Plan View (Mặt bằng)" IsChecked="True" Margin="0,0,24,0" Checked="RadView_Checked"/>
                    <RadioButton x:Name="RadViewSection" Content="Section View (Mặt cắt)" Checked="RadView_Checked"/>
                </StackPanel>
            </StackPanel>

            <Separator Background="#D1D5DB" Margin="0,0,0,12"/>

            <!-- Original Scope & Dimension Style -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Scope" Style="{StaticResource HeaderStyle}" Margin="0,0,0,6"/>
                    <RadioButton x:Name="RadSelection" Content="Selected walls" IsChecked="True"/>
                    <RadioButton x:Name="RadActiveView" Content="All visible walls in active view"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Dimension Style" Style="{StaticResource HeaderStyle}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CboDimensionTypes" Style="{StaticResource ComboStyle}" DisplayMemberPath="Name"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Separator Grid.Row="3" Background="#D1D5DB" Margin="0,12"/>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Include References" Style="{StaticResource HeaderStyle}" Margin="0,0,0,6"/>
                <CheckBox x:Name="ChkOpenings" Content="Door/window references" IsChecked="True"/>
                <CheckBox x:Name="ChkGrids" Content="Grid references" IsChecked="False"/>
                <CheckBox x:Name="ChkLinks" Content="Structural links" IsChecked="False"/>
                <ComboBox x:Name="CboLinkInstances" Style="{StaticResource ComboStyle}" DisplayMemberPath="Name" Margin="20,2,0,6" IsEnabled="{Binding IsChecked, ElementName=ChkLinks}"/>
                <CheckBox x:Name="ChkHostStructural" Content="Host structural columns (Bổ trụ/Vách)" IsChecked="True"/>
                <CheckBox x:Name="ChkIntersections" Content="Intersecting walls (reserved)" IsChecked="False" IsEnabled="False"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Opening Mode" Style="{StaticResource HeaderStyle}" Margin="0,0,0,6"/>
                <RadioButton x:Name="RadOpeningCenter" Content="Center reference"/>
                <RadioButton x:Name="RadOpeningJambs" Content="Left and right jambs" IsChecked="True"/>
            </StackPanel>
        </Grid>

        <Separator Grid.Row="5" Background="#D1D5DB" Margin="0,12"/>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Offset (mm)" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtOffset" Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="1000"/>
            <Button x:Name="BtnPickPoint" Grid.Column="3" Content="Pick Point" Style="{StaticResource SecondaryBtn}" Click="BtnPickPoint_Click"/>
            <TextBlock x:Name="TxtPickStatus" Grid.Column="4" Text="No point picked" Foreground="#4B5563" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <Separator Grid.Row="7" Background="#D1D5DB" Margin="0,12"/>

        <Border Grid.Row="8" Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="10">
            <TextBlock x:Name="TxtStatus" Text="Ready." Style="{StaticResource LabelStyle}" Foreground="#4B5563" TextWrapping="Wrap" VerticalAlignment="Top"/>
        </Border>

        <UniformGrid Grid.Row="9" Rows="1" Columns="4" Margin="0,16,0,8">
            <Button x:Name="BtnRun" Content="RUN AUTO DIM" Style="{StaticResource PrimaryBtn}" Click="BtnRun_Click"/>
            <Button x:Name="BtnDelete" Content="DELETE AUTO DIM" Style="{StaticResource DestructiveBtn}" Click="BtnDelete_Click"/>
            <Button x:Name="BtnRefresh" Content="REFRESH" Style="{StaticResource SecondaryBtn}" Click="BtnRefresh_Click"/>
            <Button x:Name="BtnClose" Content="CLOSE" Style="{StaticResource SecondaryBtn}" Click="BtnClose_Click"/>
        </UniformGrid>
        
        <TextBlock Text="@manhns" Margin="0,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280" Opacity="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False" Focusable="False"/>
    </Grid>
</Window>


